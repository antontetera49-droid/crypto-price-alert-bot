async def main():
    logger.info("🚀 Starting Crypto Alert Parser...")
    bot = Bot(token=TELEGRAM_BOT_TOKEN)
    storage = Storage()
    while True:
        logger.info("Fetching fresh price data...")
        prices = await get_crypto_prices(list(WATCHLIST.keys()))

        for coin_id, config in WATCHLIST.items():
            if coin_id not in prices:
                continue

            data = prices[coin_id]
            price = data.get("usd", 0)
            change_24h = data.get("usd_24h_change", 0)
            symbol = config["symbol"]

            logger.info(
                f"[{symbol}] Current Price: ${price:,.2f} | 24h Change: {change_24h:+.2f}%"
            )

            # Check HIGH threshold
            if price >= config["alert_above"]:
                alert_key = f"{coin_id}_above_{config['alert_above']}"
                if not storage.is_sent(alert_key):
                    msg = (
                        f"🚀 <b>{symbol} High Target Reached!</b>\n\n"
                        f"💵 <b>Current Price:</b> ${price:,.2f}\n"
                        f"📊 <b>24h Change:</b> {change_24h:+.2f}%\n"
                        f"🎯 <b>Target Level:</b> ${config['alert_above']:,.2f}"
                    )
                    await send_telegram_alert(bot, msg)
                    storage.mark_sent(alert_key)

            # Check LOW threshold
            elif price <= config["alert_below"]:
                alert_key = f"{coin_id}_below_{config['alert_below']}"
                if not storage.is_sent(alert_key):
                    msg = (
                        f"🔻 <b>{symbol} Low Target Reached!</b>\n\n"
